{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-3d",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-22",
  // La base de conocimiento (.md) se importa como texto en el bundle
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Solo /api/* invoca el Worker; el resto lo sirven los assets estáticos
    "run_worker_first": ["/api/*"]
  },
  // Límite por IP: 8 peticiones por minuto
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "3001", "simple": { "limit": 8, "period": 60 } }
  ],
  // Contador de presupuesto diario (todas las IPs juntas), para topar el gasto si abusan desde muchas IPs
  "kv_namespaces": [{ "binding": "CHAT_BUDGET", "id": "249da838d9094975952b6f419f58ea5f" }],
  // Sin secretos aquí: OPENAI_API_KEY va como secreto del Worker (o en .dev.vars en local)
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini",
    "CHAT_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://portfolio-3d.daniroma05.workers.dev,http://localhost:8787,http://127.0.0.1:8787,http://localhost:5173",
    // Tope global de peticiones reales a OpenAI por día (UTC), sumando todas las IPs
    "CHAT_DAILY_BUDGET": "300"
  }
}
